import tkinter as tk
from tkinter import ttk
import math

def evaluate_password(*args):
    pwd = pwd_var.get()
    length = len(pwd)
    
    if length == 0:
        lbl_entropy_val.config(text="0 bits")
        lbl_time_val.config(text="-")
        lbl_strength_val.config(text="-", fg="#7f8c8d")
        return
        
    # Calculate the character pool size (Search Space)
    pool = 0
    if any(c.islower() for c in pwd): pool += 26
    if any(c.isupper() for c in pwd): pool += 26
    if any(c.isdigit() for c in pwd): pool += 10
    if any(c in "!@#$%^&*()-_=+[]{};:'\",.<>/?`~\\| " for c in pwd): pool += 33
    
    # Calculate Entropy (Bits)
    entropy = length * math.log2(pool) if pool > 0 else 0
    
    # Estimate time to crack (Assuming an attacker can guess 100 Billion times per second)
    combinations = pool ** length
    guesses_per_sec = 100_000_000_000
    seconds = combinations / guesses_per_sec if guesses_per_sec > 0 else 0
    
    # Format the time output
    if seconds < 60:
        time_str = "Instant (< 1 min) ⚠️"
    elif seconds < 3600:
        time_str = f"{int(seconds // 60)} minutes"
    elif seconds < 86400:
        time_str = f"{int(seconds // 3600)} hours"
    elif seconds < 31536000:
        time_str = f"{int(seconds // 86400)} days"
    elif seconds < 3153600000:
        time_str = f"{int(seconds // 31536000)} years"
    else:
        time_str = "Centuries 🛡️"
        
    # Update GUI
    lbl_entropy_val.config(text=f"{int(entropy)} bits")
    lbl_time_val.config(text=time_str)
    
    # Strength categorization based on NIST guidelines
    if entropy < 40:
        lbl_strength_val.config(text="Weak", fg="#e74c3c")
    elif entropy < 60:
        lbl_strength_val.config(text="Moderate", fg="#f39c12")
    elif entropy < 80:
        lbl_strength_val.config(text="Strong", fg="#27ae60")
    else:
        lbl_strength_val.config(text="Very Strong", fg="#8e44ad")

# --- Tkinter GUI Layout ---
root = tk.Tk()
root.title("SOC Toolkit - Entropy Checker")
root.geometry("400x320")
root.resizable(False, False)

frame = ttk.Frame(root, padding="20")
frame.pack(fill=tk.BOTH, expand=True)

lbl_title = tk.Label(frame, text="Password Entropy Analyzer", font=("Helvetica", 13, "bold"))
lbl_title.pack(anchor="w", pady=(0, 15))

lbl_instruction = tk.Label(frame, text="Type a password to analyze its cryptographic strength:", font=("Helvetica", 9), fg="#555")
lbl_instruction.pack(anchor="w", pady=(0, 5))

# Input Field with Trace (updates on key press)
pwd_var = tk.StringVar()
pwd_var.trace_add("write", evaluate_password)

entry_pwd = ttk.Entry(frame, textvariable=pwd_var, width=35, font=("Consolas", 11))
entry_pwd.pack(anchor="w", pady=(0, 20))

# Metrics Display
metrics_frame = tk.Frame(frame)
metrics_frame.pack(fill=tk.X)

# Entropy
lbl_entropy_text = tk.Label(metrics_frame, text="Entropy (Bits):", font=("Helvetica", 10))
lbl_entropy_text.grid(row=0, column=0, sticky="w", pady=5)
lbl_entropy_val = tk.Label(metrics_frame, text="0 bits", font=("Helvetica", 10, "bold"))
lbl_entropy_val.grid(row=0, column=1, sticky="w", padx=10, pady=5)

# Crack Time
lbl_time_text = tk.Label(metrics_frame, text="Brute-Force Time:", font=("Helvetica", 10))
lbl_time_text.grid(row=1, column=0, sticky="w", pady=5)
lbl_time_val = tk.Label(metrics_frame, text="-", font=("Helvetica", 10, "bold"))
lbl_time_val.grid(row=1, column=1, sticky="w", padx=10, pady=5)

# Strength Rating
lbl_strength_text = tk.Label(metrics_frame, text="NIST Rating:", font=("Helvetica", 10))
lbl_strength_text.grid(row=2, column=0, sticky="w", pady=5)
lbl_strength_val = tk.Label(metrics_frame, text="-", font=("Helvetica", 10, "bold"), fg="#7f8c8d")
lbl_strength_val.grid(row=2, column=1, sticky="w", padx=10, pady=5)

note = tk.Label(frame, text="*Assumes attacker speed of 100 Billion hashes/sec", font=("Helvetica", 8, "italic"), fg="#7f8c8d")
note.pack(side=tk.BOTTOM, anchor="w", pady=(20, 0))

root.mainloop()